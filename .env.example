# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=production
API_DOMAIN=api.example.com
PUBLIC_BASE_URL=https://api.example.com
# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["https://panel.example.com"]

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this makes stored Instagram tokens unreadable.
ENCRYPTION_KEY=

# From the Meta App Dashboard (Instagram > API setup with Instagram login)
META_APP_ID=
META_APP_SECRET=
# Any random string; enter the same value in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Any OpenAI-compatible endpoint (OpenAI directly or an Iranian gateway)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
